{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "fintrack",
  "account_id": "6ad0888a2ee7ec203e961493dd19193e",
  "main": "server/index.ts",
  "compatibility_date": "2026-06-01",
  "assets": {
    "directory": "dist",
    "not_found_handling": "single-page-application",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "fintrack-db",
      "database_id": "8dc509fc-f072-4526-b4a3-391de733fcd7",
      "migrations_dir": "migrations"
    }
  ],
  "triggers": {
    // 每小時整點更新匯率快取
    "crons": ["0 * * * *"]
  },
  "vars": {
    // 開放註冊。每個帳號的資料完全隔離:所有查詢都以 JWT 帶出的 user_id
    // 為條件,分類也是各自一份(首次讀取時種入)。
    "ALLOW_REGISTRATION": "true",
    "MAIL_FROM": "qoock3@gmail.com",
    // 只有這個帳號看得到「核發臨時密碼」功能。留空即整個關閉。
    "ADMIN_EMAIL": "qoock3@gmail.com"
  },
  "observability": {
    "enabled": true
  }
}
